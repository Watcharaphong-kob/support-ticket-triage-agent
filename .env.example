# Set these in your shell. This file is documentation; automatic .env loading is not enabled.
OPENAI_API_KEY=
OPENAI_MODEL=

# Compose-only local prototype settings. Replace the password before startup.
POSTGRES_PASSWORD=replace-with-your-local-prototype-password
POSTGRES_PORT=54329
API_PORT=8000
EMBEDDING_BACKEND=fake
EMBEDDING_MODEL=fake-token-v1
EMBEDDING_DIMENSION=64
# Live embeddings require backend=openai, a chosen model/dimension and your own key.
